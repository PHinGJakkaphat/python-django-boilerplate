# ============================================================
# Django Boilerplate — Environment Variables Example
# Copy this file to .env and fill in your values
# ============================================================

# Security
SECRET_KEY=your-very-secret-key-here-replace-me
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Database (PostgreSQL) ----
DB_ENGINE=django.db.backends.postgresql
DB_NAME=django_boilerplate
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---- Static & Media ----
STATIC_URL=/static/
MEDIA_URL=/media/

# ---- Timezone ----
TIME_ZONE=Asia/Bangkok
